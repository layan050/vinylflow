<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_ipod_body"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.8"
            android:background="@drawable/widget_ipod_screen"
            android:padding="8dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="VINYLFLOW · NOW PLAYING"
                android:textColor="#FFB9BAC0"
                android:textSize="8sp"
                android:ellipsize="end"
                android:maxLines="1" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="5dp">
                <ImageView
                    android:id="@+id/widget_record"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:scaleType="centerCrop"
                    android:background="#FF25252A"
                    android:contentDescription="Album artwork" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="9dp">
                    <TextView
                        android:id="@+id/widget_track_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nothing playing"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/widget_track_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Choose a song"
                        android:textColor="#FFB8B8BE"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView android:layout_width="30dp" android:layout_height="32dp" android:src="@android:drawable/ic_media_previous" android:tint="#FFE7E7EA" android:padding="8dp" android:contentDescription="Previous" />
                        <ImageView android:layout_width="30dp" android:layout_height="32dp" android:src="@android:drawable/ic_media_play" android:tint="#FFFFFFFF" android:padding="8dp" android:contentDescription="Play or pause" />
                        <ImageView android:layout_width="30dp" android:layout_height="32dp" android:src="@android:drawable/ic_media_next" android:tint="#FFE7E7EA" android:padding="8dp" android:contentDescription="Next" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/widget_wheel"
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/widget_ipod_wheel">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_marginTop="10dp" android:text="MENU" android:textColor="#FFE0E0E3" android:textSize="10sp" android:textStyle="bold" />
            <ImageButton android:id="@+id/widget_previous" android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center_vertical|start" android:background="@android:color/transparent" android:src="@android:drawable/ic_media_previous" android:tint="#FFE8E8EA" android:padding="9dp" android:contentDescription="Previous" />
            <ImageButton android:id="@+id/widget_next" android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center_vertical|end" android:background="@android:color/transparent" android:src="@android:drawable/ic_media_next" android:tint="#FFE8E8EA" android:padding="9dp" android:contentDescription="Next" />
            <ImageButton android:id="@+id/widget_play_pause" android:layout_width="38dp" android:layout_height="30dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="6dp" android:background="@android:color/transparent" android:src="@android:drawable/ic_media_play" android:tint="#FFE8E8EA" android:padding="7dp" android:contentDescription="Play or pause" />
            <ImageView android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="center" android:background="@drawable/widget_ipod_wheel_center" android:contentDescription="Click wheel center" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
