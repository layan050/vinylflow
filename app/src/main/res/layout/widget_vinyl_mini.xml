<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_panel_mini"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_track_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:text="Nothing playing"
        android:textColor="#FF25252C"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_track_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Start music to spin"
        android:textColor="#FF686873"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_source"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_record"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginTop="4dp"
        android:contentDescription="Spinning vinyl record with album art" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_previous"
            android:layout_width="36dp"
            android:layout_height="34dp"
            android:background="@android:color/transparent"
            android:contentDescription="Previous track"
            android:padding="8dp"
            android:src="@android:drawable/ic_media_previous" />

        <ImageButton
            android:id="@+id/widget_play_pause"
            android:layout_width="36dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_play_button_violet"
            android:contentDescription="Play or pause"
            android:padding="8dp"
            android:src="@android:drawable/ic_media_play" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="36dp"
            android:layout_height="34dp"
            android:background="@android:color/transparent"
            android:contentDescription="Next track"
            android:padding="8dp"
            android:src="@android:drawable/ic_media_next" />
    </LinearLayout>
</LinearLayout>
